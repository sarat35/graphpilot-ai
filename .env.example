# Application
APP_NAME=buyseconds
APP_ENV=development

# Intelligent search and chat
INTELLIGENCE_MODEL_NAME=gpt-5.4-mini
PRODUCT_SEARCH_MODE=live
GOOGLE_SERPER_API_KEY=

# Optional database connection retained for server-side database work.
DATABASE_URL=

# Supabase — never expose these server-side values to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_SECRET_KEY=

# Used only by the Supabase CLI when applying migrations.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Public Supabase project configuration for the Next.js browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
